# ---------------------------------------------------------------- database
# Local development uses the Docker Postgres in compose.yml.
# In production use a pooled connection string (Neon, Supabase, RDS…).
DATABASE_URL=""

# ----------------------------------------------------------------- session
# Must be at least 32 characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# ------------------------------------------------------------ photo storage
# "local" writes to MEDIA_DIR — fine on a VPS with a mounted volume.
# "s3" targets any S3-compatible bucket and is REQUIRED on serverless hosts
# (Vercel, Netlify) because they have no persistent filesystem.
MEDIA_DRIVER="local"
MEDIA_DIR=".data/media"

# Only needed when MEDIA_DRIVER="s3". These values are for Cloudflare R2.
S3_BUCKET=""
S3_ENDPOINT=""          # https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
